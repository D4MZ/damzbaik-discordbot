# ============================================
# Discord Bot Management & Community System
# Contoh file environment variables
# Salin file ini menjadi ".env" lalu isi nilainya
# JANGAN commit file .env ke repository publik
# ============================================

# Token bot dari Discord Developer Portal (WAJIB)
DISCORD_TOKEN=YOUR_BOT_TOKEN_HERE

# ID Discord milik owner/developer bot (WAJIB, untuk command khusus owner)
BOT_OWNER_ID=123456789012345678

# Guild ID untuk sync command saat development (opsional)
# Kosongkan saat production agar command di-sync secara global
DEV_GUILD_ID=

# URL koneksi database.
# Default: SQLite (tidak perlu server database terpisah)
DATABASE_URL=sqlite+aiosqlite:///./data/bot.db
# Contoh PostgreSQL (butuh: pip install asyncpg):
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/discordbot
# Contoh MySQL (butuh: pip install aiomysql):
# DATABASE_URL=mysql+aiomysql://user:password@localhost:3306/discordbot

# Daftar activity yang diputar bergantian (pisahkan dengan karakter |)
# Placeholder {servers} akan diganti dengan jumlah server yang terhubung
# Jika dikosongkan, bot memakai status per-guild dari database seperti biasa
CUSTOM_ACTIVITIES=over {servers} servers|with the community|/help for commands

# Jeda pergantian activity (dalam detik, minimal 5)
ACTIVITY_ROTATION_INTERVAL=60

# Level logging: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Direktori penyimpanan lokal untuk image management (jika storage_type=local)
LOCAL_STORAGE_PATH=./data/images

# Konfigurasi S3-compatible storage (opsional, hanya jika storage_type=s3)
S3_ENDPOINT_URL=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET_NAME=
S3_PUBLIC_BASE_URL=
